{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_AUTHOR_LOGIN\" = \"dependabot[bot]\" ] || [ \"${VERCEL_GIT_COMMIT_REF#cursor/}\" != \"$VERCEL_GIT_COMMIT_REF\" ]",
  "crons": [
    {
      "path": "/api/cron/refresh-ticker-metrics",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/slack-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/cron/video-reconcile",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 0 * * *"
    }
  ]
}
