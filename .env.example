# --- Supabase ---------------------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser. Used by seed + grading jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Market data (live quotes) ----------------------------------------------
# Primary: Yahoo Finance via yahoo-finance2 (no key required).
# Fallbacks (optional — used only when Yahoo fails):
#   Twelve Data — https://twelvedata.com (free ~800 req/day)
#   Alpha Vantage — https://www.alphavantage.co (free 25 req/day, last resort)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Kaggle reference data (SEC financials, SP futures) ---------------------
# Optional. Used by npm run import:kaggle to download + load static datasets.
# Get keys at https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional. Enables live AI in compose + branding (https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Generate any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# --- PayPal (real-money payouts) ---------------------------------------------
# Optional. Without these, the platform runs entirely on the simulated wallet
# (top_up / purchase_report / subscribe_to_analyst SQL functions) — nothing
# else breaks. Add these once you're ready to accept real payments.
# PayPal, not Stripe Connect — Stripe Connect payouts aren't available for
# Israel-based platforms/sellers; PayPal is.
# Get a Client ID/Secret at https://developer.paypal.com/dashboard/applications.
# PAYPAL_PARTNER_ID is YOUR platform's own PayPal merchant/partner id (shown in
# the developer dashboard once your app is created), used to look up a
# creator's onboarding status. PAYPAL_WEBHOOK_ID comes from the webhook you
# subscribe under the same app. Real platform-fee splits (10% cut) require
# PayPal to approve your app for the PARTNER_FEE feature — contact your PayPal
# account manager; onboarding itself works in sandbox without that approval.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_BN_CODE=
