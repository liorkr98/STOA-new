# --- Site (SEO: metadataBase, canonical URLs, sitemap, JSON-LD) -------------
# Production origin, no trailing slash. Falls back to https://stoa.app if unset.
NEXT_PUBLIC_SITE_URL=https://stoa.app

# Show "ATTORNEY REVIEW REQUIRED" banner on legal placeholder pages (set to 0 in production after counsel delivers text).
NEXT_PUBLIC_LEGAL_PLACEHOLDER_BANNER=1

# --- Supabase ---------------------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (client-safe). New format: sb_publishable_... — replaces legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Project ref used by Supabase CLI scripts (e.g. deploying edge functions).
SUPABASE_PROJECT_REF=your-project-ref

# Public storage base URL — used to validate chart screenshot URLs on publish.
# Set to: {NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Server-only. Never expose this to the browser. Used by seed + grading jobs.
# Secret key (sb_secret_...) or legacy service_role JWT — NOT the publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# --- Upstash Redis + QStash (scale hardening) -------------------------------
# Redis powers cross-instance caching (hot market reads), rate limiting, and
# non-money idempotency-key replay. QStash is the background job queue (grading,
# notification fan-out, video pipeline). Create both at https://console.upstash.com.
# All server-only; never NEXT_PUBLIC_*. Absent = graceful degrade (in-memory
# cache/ratelimit, cron-only jobs) so the app still runs without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# QStash: token to publish jobs, signing keys to verify consumer callbacks.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Base URL QStash calls back to (your deployment origin). Defaults to
# NEXT_PUBLIC_SITE_URL when unset.
QSTASH_TARGET_BASE_URL=

# --- Market data (live quotes) ----------------------------------------------
# Primary: Yahoo Finance via yahoo-finance2 (no key required).
# Fallbacks (optional — used only when Yahoo fails):
#   Twelve Data — https://twelvedata.com (free ~800 req/day)
#   Alpha Vantage — https://www.alphavantage.co (free 25 req/day, last resort)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
# OHLC candles for chartNode hydration (Yahoo server proxy; auth + rate limit on route)

# --- Kaggle reference data (SEC financials, SP futures) ---------------------
# Optional. Used by npm run import:kaggle to download + load static datasets.
# Get keys at https://www.kaggle.com/settings -> API -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional. Enables live AI in compose, diagrams, fact-check, and branding (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# deepseek-v4-flash (default) or deepseek-v4-pro. V4 thinking is disabled in-app for JSON tools.
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Audio brief TTS (~$0.02/brief via OpenAI tts-1). DeepSeek handles script text only.
# https://platform.openai.com/docs/guides/text-to-speech
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Optional. Napkin AI — text-to-diagram visuals in Compose (/napkin slash command).
# Create a token at app.napkin.ai → Account → Developers. Server-only; never expose to the browser.
NAPKIN_API_KEY=

# Generate any long random string. No trailing newline — Vercel rejects control chars in CRON_SECRET.
CRON_SECRET=change-me-to-a-long-random-string

# Optional. Slack/email webhook pinged when /api/cron/grade succeeds or fails.
# Legacy alias for SLACK_WEBHOOK_BUGS (failures) — prefer the channel webhooks below.
CRON_ALERT_WEBHOOK_URL=

# Slack incoming webhooks — one per channel (create in Slack → Incoming Webhooks).
# Legacy alias: SLACK_CONTACT_WEBHOOK_URL still maps to #support.
SLACK_WEBHOOK_SUPPORT=
SLACK_WEBHOOK_CUSTOMERS_OPS=
SLACK_WEBHOOK_REVENUE=
SLACK_WEBHOOK_MARKETING=
SLACK_WEBHOOK_BUGS=
SLACK_WEBHOOK_OPS=
SLACK_CONTACT_WEBHOOK_URL=

# Slack bot (thread replies on #bugs after fixes). OAuth bot token with chat:write.
# Create at api.slack.com/apps → OAuth & Permissions → Bot Token Scopes:
# chat:write, channels:history, channels:read, channels:join
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BUGS_CHANNEL_ID=C0BHBFV4GCD
# Optional. POST { channelId, threadTs, sentryIssueUrl } when a new #bugs alert arrives.
CURSOR_BUG_AGENT_WEBHOOK_URL=

# --- Sentry (error monitoring) ------------------------------------------------
# DSN from Sentry → Settings → Projects → javascript-nextjs → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=stoa-m1
SENTRY_PROJECT=javascript-nextjs
# CI/Vercel only — uploads source maps for readable stack traces.
SENTRY_AUTH_TOKEN=

# --- Market data (research platform v3) --------------------------------------
# SEC EDGAR requires a descriptive User-Agent with contact info (no key needed).
SEC_EDGAR_USER_AGENT="Stoa research platform contact@example.com"
# Finnhub free tier: 60 calls/min (https://finnhub.io)
FINNHUB_API_KEY=
# Financial Modeling Prep (~250 req/day free) for modeled fundamentals + peers.
FMP_API_KEY=
# Optional FastAPI sidecar (OpenBB / finvizfinance / mstarpy / yfinance).
DATA_SERVICE_URL=

# --- Video (Cloudflare Stream, Part D — legacy in-report video block) ---------
# Optional. Without these the in-report video block reports "provider unavailable"
# and nothing else breaks. Webhook secret comes from the Stream webhook subscription.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# --- Video (Bunny Stream — video-first Discover & Dispatch) -------------------
# Hosting for the video-led Discover/Dispatch clips. Roughly half the cost of
# Cloudflare Stream. Create a Video Library at https://dash.bunny.net (Stream)
# and copy these from the library's API/settings. Server-only; never NEXT_PUBLIC_*.
#   LIBRARY_ID     numeric video library id
#   API_KEY        the library's AccessKey (NOT your account API key)
#   CDN_HOSTNAME   the pull-zone hostname, e.g. vz-xxxxxxxx-xxx.b-cdn.net
#   WEBHOOK_SECRET any long random string; append it as ?secret=... on the
#                  webhook URL you register in Bunny (Bunny does not sign webhooks)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_WEBHOOK_SECRET=

# Force the local demo MP4s instead of each row's real HLS stream. For a
# walkthrough on a machine with no Bunny data; never set this in production,
# because the demo files are multi-megabyte and carry no bitrate ladder.
STOA_DEMO_CLIPS=

# --- PayPal (real-money payouts) ---------------------------------------------
# Optional. Without these, the platform runs entirely on the simulated wallet
# (top_up / purchase_report / subscribe_to_analyst SQL functions) — nothing
# else breaks. Add these once you're ready to accept real payments.
# PayPal, not Stripe Connect — Stripe Connect payouts aren't available for
# Israel-based platforms/sellers; PayPal is.
# Get a Client ID/Secret at https://developer.paypal.com/dashboard/applications.
# PAYPAL_PARTNER_ID is YOUR platform's own PayPal merchant/partner id (shown in
# the developer dashboard once your app is created), used to look up a
# creator's onboarding status. PAYPAL_WEBHOOK_ID comes from the webhook you
# subscribe under the same app. Real platform-fee splits (10% cut) require
# PayPal to approve your app for the PARTNER_FEE feature — contact your PayPal
# account manager; onboarding itself works in sandbox without that approval.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_BN_CODE=
