# --- Supabase ---------------------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser. Used by seed + grading jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Market data ------------------------------------------------------------
# Free tier works to start. Get a key at https://finnhub.io (recommended) or
# https://polygon.io. Leave blank to run the engine in mock-price mode.
MARKET_DATA_PROVIDER=finnhub
FINNHUB_API_KEY=

# Secret that protects the scheduled grading endpoint (/api/cron/grade).
# Generate any long random string.
CRON_SECRET=change-me-to-a-long-random-string
